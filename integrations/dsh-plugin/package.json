{
  "name": "@physics31415926/fl-upgrade-workflow",
  "version": "0.6.3",
  "type": "module",
  "description": "FL plugin adaptation workbench: tracks vLLM-Plugin-FL and SGLang-Plugin-FL upgrade progress inside the Harness sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": ["dsh", "dsh-bundle", "cordis", "vllm", "sglang"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
